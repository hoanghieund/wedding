# Database Configuration
# Used by Prisma ORM to connect to Vercel Postgres (Story 1.3)
DATABASE_URL=

# Admin Authentication
# Secret key for admin password verification (Story 4.1)
ADMIN_SECRET=

# JWT Session Secret
# Secret key for signing JWT session tokens (Story 4.1)
JWT_SECRET=

# Google Sheets RSVP
# Share the target spreadsheet with GOOGLE_SHEETS_CLIENT_EMAIL.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=RSVP
